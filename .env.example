# Supabase (optional — without these, nominations save to data/nominations.json)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protect /admin and CSV export in production
ADMIN_KEY=choose-a-long-random-string

# Confirmation email to the person who submitted (optional).
# Without RESEND_API_KEY the site works normally and simply sends nothing.
RESEND_API_KEY=re_xxxxxxxxxxxx
# NOTE: the Resend-verified domain is the mail. subdomain, not the bare domain.
NOMINATION_EMAIL_FROM=RARE India <awards@mail.rareindia.com>
NOMINATION_EMAIL_REPLY_TO=shobhanaj@rareindia.com
# RARE's own copy of every nomination. Set to empty to disable the BCC.
NOMINATION_EMAIL_BCC=shobhanaj@rareindia.com
